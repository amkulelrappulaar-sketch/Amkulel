{
  "name": "amkulel",
  "main": "amkulel-worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/p/*", "/og/*", "/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "NEWSLETTER",
      "id": "7005806c873848f28763333fdb77c4ba"
    }
  ]
}
